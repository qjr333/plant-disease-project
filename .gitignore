# Raw datasets and archives: retain small metadata and split CSVs in Git.
/data/plantvillage/
/data/plantdoc/train/
/data/plantdoc/test/
*.zip
*.tar
*.tar.gz
*.7z

# Large weights and generated experiment artifacts.
*.pt
*.pth
*.ckpt
/outputs/runs/*
!/outputs/runs/.gitkeep
/outputs/figures/*
!/outputs/figures/.gitkeep
/outputs/tables/*
!/outputs/tables/.gitkeep
